{
  "name": "money-quest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --import tsx scripts/build-offline-manifest.ts",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx scripts/run-all-unit-tests.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.28",
    "next": "^15.5.28",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.23",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.47.0",
    "tsx": "^4.19.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    },
    "postcss-selector-parser": "^7.1.6"
  }
}
