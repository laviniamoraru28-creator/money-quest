[gd_resource type="Environment" load_steps=3 format=3]

; Money Quest World's shared INTERIOR atmosphere, for dressed zone rooms
; (see scripts/world/zones/ZoneDressing.gd), applied through each zone's
; EnvironmentOverride node. Same sky and tone mapping as the shared world
; environment (mq_world_environment.tres) so a room still feels like part
; of the same world, but with less, warmer ambient light: a room is mostly
; pale floor and walls, which wash out to near-white under the outdoor
; settings. Paired with ZoneDressing's softer sun (energy 0.6). No fog —
; rooms are small. Only GL Compatibility features.

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_mq"]
sky_top_color = Color(0.33, 0.6, 0.82, 1)
sky_horizon_color = Color(0.8, 0.89, 0.9, 1)
sky_curve = 0.11
ground_bottom_color = Color(0.42, 0.56, 0.45, 1)
ground_horizon_color = Color(0.8, 0.89, 0.9, 1)
ground_curve = 0.05
sun_angle_max = 18.0
sun_curve = 0.12

[sub_resource type="Sky" id="Sky_mq"]
sky_material = SubResource("ProceduralSkyMaterial_mq")

[resource]
background_mode = 2
sky = SubResource("Sky_mq")
ambient_light_source = 3
ambient_light_color = Color(1, 0.95, 0.86, 1)
ambient_light_sky_contribution = 0.2
ambient_light_energy = 0.28
reflected_light_source = 2
tonemap_mode = 0
tonemap_exposure = 1.0
