[ext_resource type="Script" path="res://scripts/core/ChoiceOption.gd" id="3"]
[ext_resource type="Script" path="res://scripts/core/ConsequenceEffect.gd" id="4"]

[sub_resource type="Resource" id="ConsequenceEffect_explain_simply"]
script = ExtResource("4")
coin_delta = 5
xp_delta = 5
consequence_text_key = "eq.decision.product_unclear.choice.explain_simply.consequence"

[sub_resource type="Resource" id="ChoiceOption_explain_simply"]
