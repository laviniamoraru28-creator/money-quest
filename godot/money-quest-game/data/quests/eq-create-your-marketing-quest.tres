[sub_resource type="Resource" id="DialogueChoice_product_unclear"]
script = ExtResource("2")
situation_text_key = "eq.decision.product_unclear.situation"
options = Array[ChoiceOption]([SubResource("ChoiceOption_explain_simply"), SubResource("ChoiceOption_add_picture"), SubResource("ChoiceOption_do_nothing")])

