label_key = "eq.decision.materials_cost_increase.choice.find_cheaper_materials.label"
consequence = SubResource("ConsequenceEffect_find_cheaper_materials")

[sub_resource type="Resource" id="DialogueChoice_materials_cost_increase"]
script = ExtResource("2")
situation_text_key = "eq.decision.materials_cost_increase.situation"
options = Array[ChoiceOption]([SubResource("ChoiceOption_raise_price"), SubResource("ChoiceOption_absorb_cost"), SubResource("ChoiceOption_find_cheaper_materials")])

[resource]
script = ExtResource("1")
