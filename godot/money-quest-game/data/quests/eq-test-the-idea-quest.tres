[gd_resource type="Resource" script_class="QuestData" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/quests/QuestData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/core/DialogueChoice.gd" id="2"]
[ext_resource type="Script" path="res://scripts/core/ChoiceOption.gd" id="3"]
[ext_resource type="Script" path="res://scripts/core/ConsequenceEffect.gd" id="4"]

[sub_resource type="Resource" id="ConsequenceEffect_spend_it_all_now"]
script = ExtResource("4")
coin_delta = 2
xp_delta = 5
consequence_text_key = "eq.decision.test_before_invest.choice.spend_it_all_now.consequence"

[sub_resource type="Resource" id="ChoiceOption_spend_it_all_now"]
script = ExtResource("3")
label_key = "eq.decision.test_before_invest.choice.spend_it_all_now.label"
consequence = SubResource("ConsequenceEffect_spend_it_all_now")

[sub_resource type="Resource" id="ConsequenceEffect_test_a_little_first"]
script = ExtResource("4")
coin_delta = 5
xp_delta = 5
consequence_text_key = "eq.decision.test_before_invest.choice.test_a_little_first.consequence"

[sub_resource type="Resource" id="ChoiceOption_test_a_little_first"]
script = ExtResource("3")
label_key = "eq.decision.test_before_invest.choice.test_a_little_first.label"
consequence = SubResource("ConsequenceEffect_test_a_little_first")

[sub_resource type="Resource" id="DialogueChoice_test_before_invest"]
script = ExtResource("2")
situation_text_key = "eq.decision.test_before_invest.situation"
options = Array[ChoiceOption]([SubResource("ChoiceOption_spend_it_all_now"), SubResource("ChoiceOption_test_a_little_first")])

[resource]
script = ExtResource("1")
quest_id = "eq-test-the-idea-quest"
title_key = "quest.eq_test_the_idea.title"
description_key = "quest.eq_test_the_idea.description"
educational_objective_key = "quest.eq_test_the_idea.intro"
track = "entrepreneur-quest"
zone_id = "research-lab"
giver_npc_id = "test-guide"
kind = 2
intro_text_key = "quest.eq_test_the_idea.intro"
challenge_choice = SubResource("DialogueChoice_test_before_invest")
reward_message_key = "quest.eq_test_the_idea.reward_message"
xp_reward = 15
coin_reward = 10
skill_ids = Array[String](["risk-management", "planning", "critical-thinking"])
