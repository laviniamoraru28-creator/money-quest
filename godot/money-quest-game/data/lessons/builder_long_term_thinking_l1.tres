options = Array[ChoiceOption]([SubResource("ChoiceOption_write_it_down"), SubResource("ChoiceOption_ask_someone")])

[resource]
script = ExtResource("1")
lesson_id = "builder-long_term_thinking-l1"
age_band = "builder"
