[gd_resource type="Resource" script_class="RouteChapterData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/guided/RouteChapterData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/guided/MissionStepData.gd" id="2"]

[sub_resource type="Resource" id="m1"]
script = ExtResource("2")
mission_id = "c1-save"
zone_id = "golden-vault"
goal_icons = Array[String](["coin", "then", "jar"])
instruction_key = "guided.c1.save"
done_when = "activity:gv-first-savings"
finish_objective = ""

[sub_resource type="Resource" id="m2"]
script = ExtResource("2")
mission_id = "c1-buy"
zone_id = "market-town"
goal_icons = Array[String](["coin", "then", "stall", "then", "bag"])
instruction_key = "guided.c1.buy"
done_when = "activity:mt-first-purchase|activity:obj:mt.buy"
finish_objective = ""

[sub_resource type="Resource" id="m3"]
script = ExtResource("2")
mission_id = "c1-time"
zone_id = "time-vault"
goal_icons = Array[String](["coins", "then", "clock", "then", "growth"])
instruction_key = "guided.c1.time"
done_when = "state:time_vault:runs"
finish_objective = "tv.next"

[resource]
script = ExtResource("1")
chapter_id = "c1-coins"
order = 1
title_key = "guided.c1.title"
icons = Array[String](["coin", "jar", "stall"])
steps = Array[MissionStepData]([SubResource("m1"), SubResource("m2"), SubResource("m3")])
