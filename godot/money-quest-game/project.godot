; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Money Quest World"
config/description="Money Quest World — the interactive 3D universe of the Money Quest ecosystem. A free financial-education experience for children and teenagers. All money shown in this game is virtual and has no real-world value."
run/main_scene="res://scenes/menus/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.929, 0.953, 0.909, 1)
config/icon="res://icon.svg"

[autoload]

Localization="*res://autoload/Localization.gd"
Settings="*res://autoload/Settings.gd"
GameState="*res://autoload/GameState.gd"
ProgressManager="*res://autoload/ProgressManager.gd"
BusinessBuilder="*res://autoload/BusinessBuilder.gd"
SaveManager="*res://autoload/SaveManager.gd"
AudioManager="*res://autoload/AudioManager.gd"
DialogueBox="*res://scenes/ui/DialogueBox.tscn"
ChoicePanel="*res://scenes/ui/ChoicePanel.tscn"
RewardPopup="*res://scenes/ui/RewardPopup.tscn"
MatchPanel="*res://scenes/ui/MatchPanel.tscn"
SpotPanel="*res://scenes/ui/SpotPanel.tscn"
AllocatePanel="*res://scenes/ui/AllocatePanel.tscn"
SortPanel="*res://scenes/ui/SortPanel.tscn"
TextInputPanel="*res://scenes/ui/TextInputPanel.tscn"
LogoBuilderPanel="*res://scenes/ui/LogoBuilderPanel.tscn"
CategoryPickerPanel="*res://scenes/ui/CategoryPickerPanel.tscn"
NumericInputPanel="*res://scenes/ui/NumericInputPanel.tscn"
SimulatorPanel="*res://scenes/ui/SimulatorPanel.tscn"
PitchDisplayPanel="*res://scenes/ui/PitchDisplayPanel.tscn"
BookCardPanel="*res://scenes/ui/BookCardPanel.tscn"
MentorCardPanel="*res://scenes/ui/MentorCardPanel.tscn"
ExhibitCardPanel="*res://scenes/ui/ExhibitCardPanel.tscn"
MindLabEntryCardPanel="*res://scenes/ui/MindLabEntryCardPanel.tscn"
WorldManager="*res://autoload/WorldManager.gd"
QuestManager="*res://autoload/QuestManager.gd"
LibraryManager="*res://autoload/LibraryManager.gd"
MuseumManager="*res://autoload/MuseumManager.gd"
MindLabManager="*res://autoload/MindLabManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/handheld/orientation="sensorLandscape"

