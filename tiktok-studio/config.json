{
  "brand": {
    "name": "Money Quest",
    "website": "https://moneyquesteducation.com",
    "colors": {
      "teal": "#0F7A6B",
      "deep": "#0B3B36",
      "gold": "#E8A33D",
      "purple": "#5B3D85",
      "cream": "#FFF8EC",
      "white": "#FFFFFF"
    },
    "cta_lines": [
      "Help your child build real-life skills.",
      "Explore Money Quest.",
      "Link in bio."
    ]
  },
  "website_repo_root": "..",
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "min_seconds": 25,
    "max_seconds": 46,
    "max_words_per_second": 3.6,
    "safe_zone": {
      "left": 60,
      "right": 140,
      "top": 200,
      "bottom": 420
    }
  },
  "fonts": {
    "bold": [
      "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
      "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
      "/usr/share/fonts/truetype/freefont/FreeSansBold.ttf"
    ],
    "regular": [
      "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
      "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
      "/usr/share/fonts/truetype/freefont/FreeSans.ttf"
    ],
    "serif_bold": [
      "/usr/share/fonts/truetype/liberation/LiberationSerif-Bold.ttf",
      "/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf"
    ]
  },
  "schedule": {
    "videos_per_week": 3,
    "days": [
      "Mon",
      "Wed",
      "Fri"
    ],
    "note": "The actual cron lives in .github/workflows/tiktok-studio.yml"
  },
  "selection": {
    "avoid_category_repeat_within": 2,
    "performance_weight_bounds": [
      0.7,
      1.3
    ]
  },
  "hashtags_base": [
    "#parenting",
    "#financialliteracy",
    "#parentingtips",
    "#kidsandmoney"
  ],
  "music_gain": 0.25,
  "_music_gain_note": "0.25 = quiet bed for notification publishing, where a TikTok sound is added in the app. Use 1.0 for fully automatic publishing.",
  "series": "quotes",
  "_series_note": "quotes = quotation series (curriculum/quotes.json); tips = parent problem-to-solution series (curriculum/topics.json).",
  "quote_series": {
    "music_gain": 0.5
  }
}
