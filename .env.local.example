# Copy this file to .env.local if you need either of these. Both are
# genuinely optional — the app works correctly with neither set.
#
# This project has no database, no authentication, and no accounts
# after the privacy-first redesign (see docs/final-architecture-report.md)
# — there is no longer a Supabase URL, API key, or session secret of
# any kind for this file to hold. That is not an omission; it is the
# point of the redesign.

# The site's canonical public URL — used for canonical links, sitemap
# entries, Open Graph URLs, and structured data. Safe to expose
# client-side (NEXT_PUBLIC_) since it's just the site's own address.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Optional: a webhook URL (Sentry, Better Stack, a Slack webhook, etc.)
# that receives a JSON POST for every server or client error. Without
# this set, errors still log to console/hosting-platform logs, just
# without a dedicated alerting service. See src/lib/monitoring/report-error.ts.
ERROR_REPORTING_WEBHOOK_URL=
