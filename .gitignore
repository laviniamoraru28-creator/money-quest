# Dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts

# Environment / secrets (the .example file is intentionally tracked)
.env
.env.*
!.env*.example

# Test artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
coverage/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# TypeScript incremental build cache
*.tsbuildinfo

# Deployment build artifacts produced locally by the Namecheap workflow
/deploy/
moneyquest-namecheap-built.zip

# Generated from the actual production build
/public/offline-manifest.json

# Localized fallback HTML generated only for active release locales
/public/offline-pages/*.html

# Local agent worktree scaffolding (git worktrees for background subagents)
/.claude/

# Sandbox-only Playwright override (pre-installed Chromium revision
# mismatch workaround); never used by CI, which installs its own browser
/playwright.local.config.ts

# Generated locale worksheets are built from canonical lesson messages
/public/worksheets/en/
/public/worksheets/ro/
/public/worksheets/es/
/public/worksheets/fr/
/public/worksheets/de/
/public/worksheets/it/
/public/worksheets/pt/
/public/worksheets/nl/
/public/worksheets/pl/
