# Default remains off. Never paste credentials in source, commits or chat.
# sandbox: simulated payments. live: real charges, after the host-side readiness checks.
MONEYQUEST_COMMERCE_MODE=off
# Prefer a restricted key. Live mode requires rk_live_; sandbox uses rk_test_ / sk_test_.
# Host secret/environment settings only. Use separate keys/signing secrets per environment.
MONEYQUEST_STRIPE_KEY=
MONEYQUEST_STRIPE_WEBHOOK_SECRET=
MONEYQUEST_ORDER_SIGNING_SECRET=
# Absolute persistent private directories, outside both the application and web document root.
MONEYQUEST_ORDER_DIRECTORY=
MONEYQUEST_DOWNLOAD_DIRECTORY=
# Required in live mode: the actual public document root and private release JSON file.
MONEYQUEST_DOCUMENT_ROOT=
MONEYQUEST_LIVE_RELEASE_FILE=
# Existing SANDBOX prices only. Replace with verified inclusive GBP live prices for live mode.
MONEYQUEST_STRIPE_FAMILY_PRICE_ID=price_1UVcFuHDC3WzcjKr1sehD6Qe
MONEYQUEST_STRIPE_JOURNAL_PRICE_ID=price_1UVcIxHDC3WzcjKrDcvarmph
# A verified transactional mailbox. No mail provider is purchased/configured by this example.
MONEYQUEST_SMTP_HOST=
MONEYQUEST_SMTP_PORT=465
MONEYQUEST_SMTP_USER=
MONEYQUEST_SMTP_PASSWORD=
MONEYQUEST_SMTP_FROM=
